{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "408 knowledge point syllabus mapping index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "selectionBasis",
    "knowledgePoints"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "selectionBasis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "knowledgePoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "name",
          "topicPath",
          "aliases",
          "syllabusPath",
          "basisYear",
          "verified",
          "source",
          "checkedAt",
          "mappingStatus",
          "mappingNote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(DS|CO|OS|CN)-[A-Z]+-[0-9]{3}$"
          },
          "subject": {
            "enum": [
              "数据结构",
              "计算机组成原理",
              "操作系统",
              "计算机网络"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "topicPath": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "syllabusPath": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            ]
          },
          "basisYear": {
            "type": "string",
            "pattern": "^(待核|[12][0-9]{3})$"
          },
          "verified": {
            "type": "boolean"
          },
          "source": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "title",
              "publisher",
              "reference",
              "locator",
              "kind",
              "mappingScope",
              "sha256"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "publisher": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reference": {
                "type": "string",
                "pattern": "^(https://|material:)\\S+"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "exam-authority",
                  "official-repost",
                  "user-provided-primary",
                  "third-party-outline"
                ]
              },
              "mappingScope": {
                "enum": [
                  "topic",
                  "upper-topic"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "sha256Scope": {
                "enum": [
                  "normalized-article-text-v1"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "third-party-outline"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "sha256Scope"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "reference": {
                      "pattern": "^https://(?:[A-Za-z0-9-]+\\.)*[cC][sS][gG][rR][aA][dD][uU][aA][tT][eE][sS]\\.[cC][oO][mM](?::443)?(?:[/?#]|$)"
                    }
                  },
                  "required": [
                    "reference"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "const": "third-party-outline"
                    }
                  }
                }
              }
            ]
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "mappingStatus": {
            "enum": [
              "direct",
              "upper-topic",
              "not-found"
            ]
          },
          "mappingNote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "knowledgeCard": {
            "type": "string",
            "pattern": "^knowledge-cards/(DS|CO|OS|CN)-[A-Z]+-[0-9]{3}\\.json$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verified": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "basisYear": {
                  "type": "string",
                  "pattern": "^[12][0-9]{3}$"
                },
                "syllabusPath": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "source": {
                  "type": "object"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basisYear": {
                  "const": "待核"
                }
              }
            },
            "then": {
              "properties": {
                "verified": {
                  "const": false
                },
                "syllabusPath": {
                  "type": "null"
                },
                "source": {
                  "type": "null"
                },
                "checkedAt": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mappingStatus": {
                  "const": "direct"
                }
              },
              "required": [
                "mappingStatus"
              ]
            },
            "then": {
              "properties": {
                "verified": {
                  "const": true
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "mappingScope": {
                      "const": "topic"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mappingStatus": {
                  "const": "upper-topic"
                }
              },
              "required": [
                "mappingStatus"
              ]
            },
            "then": {
              "properties": {
                "verified": {
                  "const": true
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "mappingScope": {
                      "const": "upper-topic"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mappingStatus": {
                  "const": "not-found"
                }
              },
              "required": [
                "mappingStatus"
              ]
            },
            "then": {
              "properties": {
                "verified": {
                  "const": false
                },
                "source": {
                  "type": "null"
                },
                "syllabusPath": {
                  "type": "null"
                },
                "checkedAt": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basisYear": {
                  "const": "2027"
                },
                "verified": {
                  "const": true
                }
              },
              "required": [
                "basisYear",
                "verified"
              ]
            },
            "then": {
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "third-party-outline"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
